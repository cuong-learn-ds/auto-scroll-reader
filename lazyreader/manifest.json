{
  "manifest_version": 3,
  "name": "LazyReader",
  "version": "0.1.0",
  "description": "Tự động chuyển trang khi đọc truyện: cuộn mượt mỗi 5-10 giây, chờ ảnh lazy-load tải xong.",
  "permissions": ["storage"],
  "action": {
    "default_title": "LazyReader - mở/đóng bảng điều khiển"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
